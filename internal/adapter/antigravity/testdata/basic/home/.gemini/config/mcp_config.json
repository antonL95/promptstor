{
  "mcpServers": {
    "docs": {
      "command": "example-docs",
      "args": ["--stdio"],
      "env": { "DOCS_TOKEN": "fixture-token-value", "MODE": "readonly" },
      "disabled": false,
      "timeoutSeconds": 600
    },
    "remote": {
      "serverUrl": "https://mcp.example.com/mcp",
      "headers": { "Authorization": "Bearer fixture-bearer-value" }
    },
    "old": {
      "httpUrl": "https://old.example.com/mcp"
    },
    "off": {
      "command": "example-off",
      "disabled": true
    },
    "signed": {
      "serverUrl": "https://signed.example.com/mcp",
      "oauth": { "clientId": "example-client", "clientSecret": "fixture-secret-value" }
    }
  }
}
