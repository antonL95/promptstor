<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.promptstor.check</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/promptstor/bin/promptstor</string>
		<string>doctor</string>
		<string>--check</string>
		<string>--notify</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>XDG_CONFIG_HOME</key>
		<string>/srv/dot files/&lt;a&amp;b&gt;/100%/it&#39;s &#34;here&#34;\now</string>
		<key>XDG_STATE_HOME</key>
		<string>/srv/state/$USER</string>
		<key>CODEX_HOME</key>
		<string>/srv/codex</string>
	</dict>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>HOME/.local/state/promptstor/check.log</string>
	<key>StandardErrorPath</key>
	<string>HOME/.local/state/promptstor/check.log</string>
</dict>
</plist>
